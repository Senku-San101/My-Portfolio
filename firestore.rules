rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper to check if user is the specific admin
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == '000means000@gmail.com' ||
        request.auth.token.email == 'abdo@kamal.portfolio'
      );
    }

    match /profile/main {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /experiences/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /projects/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /certificates/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /skills/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /messages/{id} {
      allow create: if true;
      allow read, delete: if isAdmin();
    }

    match /visits/{id} {
      allow create: if true;
      allow update: if true; // In a production app, we would restrict this to the owner of the sessionId
      allow read, delete: if isAdmin();
    }

    match /blogs/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /specializations/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/config {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /ops_vault/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
