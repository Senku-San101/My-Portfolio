rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // Allow public read access to all files
      allow read: if true;
      
      // Only allow the admin to upload/delete
      // Matches the logic in our firestore.rules
      allow write: if request.auth != null && (
        request.auth.token.email == '000means000@gmail.com' ||
        request.auth.token.email == 'abdo@kamal.portfolio'
      );
    }
  }
}
